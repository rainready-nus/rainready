{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRainReadyAndRdsSecretsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-1:*:secret:rainready/*",
        "arn:aws:secretsmanager:ap-southeast-1:*:secret:rds!*"
      ]
    }
  ]
}
