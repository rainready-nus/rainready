# Local development only. Copy to .env if you need to override these defaults.
# Keep real tokens and credentials out of this file and out of Git.
PORT=8787
RAINREADY_DB_FILE=backend/data/rainready.sqlite
RAINREADY_LEGACY_DATA_FILE=backend/data/events.json
# Local development defaults. The server remains bound to 127.0.0.1.
RAINREADY_PUBLIC_DEPLOYMENT=false
RAINREADY_COOKIE_SECURE=false
RAINREADY_REQUIRE_ORIGIN=false
# Optional comma-separated exact origins for local integration testing; never use wildcard origins.
RAINREADY_ALLOWED_ORIGINS=
# Option A: paste a valid OneMap access token. It expires after three days.
ONEMAP_ACCESS_TOKEN=
# Option B (recommended for the local prototype): set the registered OneMap credentials.
# The backend generates and caches a token, then refreshes and retries once when OneMap rejects an expired token.
# These values stay server-side. Keep the real .env local and never commit it.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=

