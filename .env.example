# Local development only. Copy to .env if you need to override these defaults.
# Keep real tokens and credentials out of this file and out of Git.
PORT=8787
RAINREADY_DB_FILE=backend/data/rainready.sqlite
RAINREADY_LEGACY_DATA_FILE=backend/data/events.json
# Local development defaults. The server remains bound to 127.0.0.1.
RAINREADY_PUBLIC_DEPLOYMENT=false
RAINREADY_COOKIE_SECURE=false
RAINREADY_REQUIRE_ORIGIN=false
# Optional comma-separated exact origins for local integration testing; never use wildcard origins.
RAINREADY_ALLOWED_ORIGINS=
# Option A: paste a valid OneMap access token. It expires after three days.
ONEMAP_ACCESS_TOKEN=
# Option B (recommended for the local prototype): set the registered OneMap credentials.
# The backend generates and caches a token, then refreshes and retries once when OneMap rejects an expired token.
# These values stay server-side. Keep the real .env local and never commit it.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=

# Database: sqlite (default, no setup) or postgres (needs `npm install pg` and the settings below).
RAINREADY_DB_DRIVER=sqlite
# PostgreSQL connection, used when RAINREADY_DB_DRIVER=postgres and by `npm run test:pg`.
# Local Docker: same port as POSTGRES_PORT, and the APP_DB_PASSWORD from database/postgres/.env.
RAINREADY_DB_HOST=127.0.0.1
RAINREADY_DB_PORT=5432
RAINREADY_DB_NAME=rainready
RAINREADY_DB_USER=rainready_app
RAINREADY_DB_PASSWORD=
# off for local Docker. For RDS through the tunnel: verify-ca, with RAINREADY_DB_SSL_CA set to
# the downloaded global-bundle.pem path.
RAINREADY_DB_SSL=off
RAINREADY_DB_SSL_CA=

# Sponsored messages (ads) on the Free plan: house (default) shows the demo catalogue, off hides ads.
RAINREADY_ADS=house
# Optional: path to another ad catalogue JSON (default backend/ads-catalogue.json).
RAINREADY_ADS_FILE=
